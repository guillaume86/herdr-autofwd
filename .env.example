# Copy to .env (git-ignored) to change where the scripts put and test mods. Every line is
# optional; a variable already set in the shell wins over this file. A leading ~ is your home.

# The herdr-app home the scripts use: `pnpm dev` and `pnpm deploy-mods` write its mods/,
# `pnpm typecheck` reads its .d.ts, `herdr-app check` runs against it. A throwaway by
# default: its window (`pnpm app`) shows your real spaces and terminals, but its layouts,
# mods and settings are its own, so a broken mod cannot touch the window you work in.
HERDR_TOOLS_HOME=~/.config/herdr-tools-app

# The home of the window you work in: where `pnpm deploy-mods --real` puts a mod once it is
# good. Set it when yours is not the default (HERDR_APP_HOME when you start herdr-app).
HERDR_TOOLS_REAL_HOME=~/.config/herdr-app

# The herdr-app program `pnpm app` opens and `herdr-app check` runs: a path, for a build that
# is not the one on PATH. `pnpm typecheck` says when its types differ from types/.
HERDR_TOOLS_APP_BIN=herdr-app
